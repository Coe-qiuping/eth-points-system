{
  "name": "eth-points-system",
  "version": "1.0.0",
  "private": true,
  "description": "以太坊通用积分系统：发行、转账、消耗与兑换",
  "scripts": {
    "compile": "node node_modules/hardhat/internal/cli/cli.js compile",
    "test": "node node_modules/hardhat/internal/cli/cli.js test",
    "node": "node node_modules/hardhat/internal/cli/cli.js node",
    "deploy": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy.js --network localhost",
    "deploy:inproc": "node node_modules/hardhat/internal/cli/cli.js run scripts/deploy.js",
    "gen:config": "node scripts/gen-frontend-config.js",
    "dev": "node node_modules/vite/bin/vite.js frontend --port 5175",
    "build": "node node_modules/vite/bin/vite.js build frontend",
    "preview": "node node_modules/vite/bin/vite.js preview frontend --port 5175"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "hardhat": "2.28.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "ethers": "6.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11",
    "@vitejs/plugin-react": "4.3.4"
  }
}
